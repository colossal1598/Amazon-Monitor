# --- WhatsApp (local wa-server on this PC, NOT Meta Cloud API) ---
# The monitor POSTs to http://localhost:3001/send . wa-server still requires a shared
# secret header so random programs on the machine cannot send messages.
# Use the same value as API_KEY in wa-server/server.js (or your deployed wa-server config).
WA_API_URL=http://localhost:3001/send
WA_API_KEY=same_secret_as_wa_server

# --- Admin UI (browser login at http://127.0.0.1) ---
# Separate from WhatsApp — only protects the settings web panel.
ADMIN_UI_USER=admin
ADMIN_UI_PASSWORD=change_this_to_a_long_random_password
